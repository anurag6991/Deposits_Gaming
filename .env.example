# Copy to .env.development (local) or create .env.production on the VPS.
# NEVER commit a file with real values. This file holds names only.

# ---------- Runtime ----------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
APP_TIMEZONE=Asia/Kolkata

# ---------- Database ----------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=
# Prisma needs a second scratch database to diff migrations during development.
SHADOW_DATABASE_URL=

# ---------- Auth ----------
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ---------- Encryption ----------
# Exactly 32 bytes, base64 encoded. Generate with: openssl rand -base64 32
# Encrypts proxy passwords and test-account secrets. Losing this makes them
# unreadable; rotating it requires re-encrypting existing rows.
ENCRYPTION_KEY=

# ---------- Bootstrap (first run only) ----------
# Used once by `npm run bootstrap` to create the single Super Admin.
# Remove these values from the environment after the account exists.
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=
BOOTSTRAP_SUPERADMIN_NAME=

# ---------- Uploads ----------
MAX_UPLOAD_MB=10

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# ---------- Logging ----------
LOG_LEVEL=debug
LOG_DIR=./logs

# ---------- Backups (production only) ----------
BACKUP_DIR=/var/backups/deposits
BACKUP_RETENTION_DAYS=30
BACKUP_REMOTE_TARGET=
